# ===========================================
# Telegram Bot Configuration
# ===========================================

# Получите токен у @BotFather в Telegram
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# ID администраторов (менеджеров поддержки)
# Получите свой ID у @userinfobot
# Можно указать несколько через запятую
ADMIN_IDS=123456789,987654321

# ===========================================
# PostgreSQL Database Configuration
# ===========================================

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=support_bot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

# ===========================================
# Redis Configuration
# ===========================================

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ===========================================
# Bot Settings
# ===========================================

# Язык по умолчанию (ru, en, es, ua)
DEFAULT_LANGUAGE=ru

# Поддерживаемые языки (через запятую)
SUPPORTED_LANGUAGES=ru,en,es,ua

# Максимальное количество активных тикетов на пользователя
MAX_ACTIVE_TICKETS_PER_USER=3

# Время автозакрытия неактивных тикетов (в минутах)
AUTO_CLOSE_TIMEOUT=60

# ===========================================
# pgAdmin Configuration (опционально)
# ===========================================

# Email для входа в pgAdmin
PGADMIN_EMAIL=admin@admin.com

# Пароль для входа в pgAdmin
PGADMIN_PASSWORD=admin

# ===========================================
# Logging Configuration (опционально)
# ===========================================

# Уровень логирования: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
